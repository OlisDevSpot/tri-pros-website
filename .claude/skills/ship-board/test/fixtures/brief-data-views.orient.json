      "id": "data-views-footer-updating-under-the-error-screen",
      "op": "set",
      "lane": "data-views",
      "askedBy": "orient",
      "askedOn": "2026-11-18",
      "phase": "DV4",
      "kind": "decision",
      "ref": null,
      "area": "polish",
      "order": 2,
      "question": "Under an error screen, the table footer still says \"Updating…\". When do we fix it?",
      "context": "When a list fails to load, its footer still says it is refreshing. The design already fixed the same contradiction for the row count, and the fix is a few lines.",
      "options": [
        {
          "label": "Fix it in this release",
          "consequence": "Goes into the data views PR"
        },
        {
          "label": "A small step of its own after the release",
          "consequence": "Ships sooner; the wrong label stays on prod a little longer"
        }
      ],
      "recommended": "Fix it in this release"
    },
    {
