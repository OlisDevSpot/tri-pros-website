      "phase": "DV10",
      "kind": "decision",
      "ref": null,
      "area": "accessibility",
      "order": 3,
      "question": "Should a list tell screen readers it is loading?",
      "context": "While a list draws its first placeholder rows, nothing marks it as busy (aria-busy). The design does not say. Only screen-reader users notice.",
      "options": [
        {
          "label": "Add it in this release",
          "consequence": "One attribute on each list"
        },
        {
          "label": "Add it with the loading-screens step",
          "consequence": "Batched with the other loading work"
        },
        {
          "label": "Leave it out",
          "consequence": "No change"
        }
      ],
      "recommended": "Add it with the loading-screens step"
