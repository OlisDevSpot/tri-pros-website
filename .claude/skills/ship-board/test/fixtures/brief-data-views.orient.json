      "order": 1,
      "question": "Which lane merges first, given that the folder move touches 92 files?",
      "context": "Data views moves 92 files to new folders. Proposal page and Office TV still import the old paths, so whichever ships second has to re-point its imports.",
      "options": [
        {
          "label": "Data views first",
          "consequence": "Proposal page and Office TV re-point their imports at their next catch-up merge"
        },
        {
          "label": "Data views last",
          "consequence": "Data views waits; it re-points their new imports itself before its PR"
        }
      ],
      "recommended": "Data views first"
    },
